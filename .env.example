# Sao chép file này thành .env rồi thay các đường dẫn phù hợp với máy của bạn.
# .env chứa đường dẫn cục bộ nên không được đưa lên Git.

# Mã nguồn IP-LAP gốc (clone/cài đặt riêng hoặc dùng Git submodule).
LORATALK_IP_LAP_DIR=/duong-dan/toi/IP_LAP

# Stage 1: Landmark LoRA
LORATALK_PRETRAINED_LANDMARK_CKPT=checkpoints/pretrained/landmark_pretrain.pth
LORATALK_LANDMARK_CKPT=checkpoints/landmark/loratalk_landmark.pth
LORATALK_LORA_OUTPUT_DIR=outputs/stage01_loratalk_landmark

# Dataset Stage 1
LORATALK_TRAIN_FILELIST=/duong-dan/toi/dataset/filelists/train.txt
LORATALK_VAL_FILELIST=/duong-dan/toi/dataset/filelists/val.txt
LORATALK_LANDMARK_ROOT=/duong-dan/toi/dataset/05_landmark
LORATALK_AUDIO_ROOT=/duong-dan/toi/dataset/06_audio

# Stage 2: PAA Renderer
LORATALK_PRETRAINED_RENDERER=checkpoints/pretrained/renderer_checkpoint.pth
LORATALK_RENDERER_DATA_ROOT=/duong-dan/toi/dataset
LORATALK_RENDERER_TRAIN_FILELIST=/duong-dan/toi/dataset/filelists/train.txt
LORATALK_RENDERER_VAL_FILELIST=/duong-dan/toi/dataset/filelists/val.txt
LORATALK_RENDERER_SKETCH_ROOT=04_sketch_loratalk
LORATALK_RENDERER_OUTPUT_DIR=outputs/renderer_paa
